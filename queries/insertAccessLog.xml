<query id="insertAccessLog" action="insert">
	<tables>
		<table name="log_admin_access" />
	</tables>
	<columns>
		<column name="chain" var="chain" notnull="notnull" />
		<column name="seq" var="seq" notnull="notnull" />
		<column name="regdate" var="regdate" notnull="notnull" />
		<column name="member_srl" var="member_srl" default="0" />
		<column name="user_id" var="user_id" />
		<column name="nick_name" var="nick_name" />
		<column name="user_role" var="user_role" />
		<column name="ipaddress" var="ipaddress" notnull="notnull" />
		<column name="user_agent" var="user_agent" />
		<column name="request_method" var="request_method" />
		<column name="request_url" var="request_url" />
		<column name="module" var="module" />
		<column name="mid" var="mid" />
		<column name="act" var="act" />
		<column name="task_type" var="task_type" notnull="notnull" />
		<column name="target_type" var="target_type" />
		<column name="target_srl" var="target_srl" default="0" />
		<column name="subject_member_srl" var="subject_member_srl" default="0" />
		<column name="subject_info" var="subject_info" />
		<column name="result" var="result" />
		<column name="result_message" var="result_message" />
		<column name="request_vars" var="request_vars" />
		<column name="prev_hash" var="prev_hash" />
		<column name="hash" var="hash" notnull="notnull" />
	</columns>
</query>
