<query id="getAccessLogExport" action="select">
	<tables>
		<table name="log_admin_access" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="excess" column="log_id" var="after_log_id" />
		<condition operation="gte" column="regdate" var="start_date" pipe="and" />
		<condition operation="lte" column="regdate" var="end_date" pipe="and" />
		<condition operation="equal" column="member_srl" var="member_srl" pipe="and" />
		<condition operation="equal" column="user_id" var="user_id" pipe="and" />
		<condition operation="like_prefix" column="ipaddress" var="ipaddress" pipe="and" />
		<condition operation="equal" column="task_type" var="task_type" pipe="and" />
		<condition operation="like" column="act" var="act" pipe="and" />
		<condition operation="equal" column="subject_member_srl" var="subject_member_srl" pipe="and" />
		<condition operation="equal" column="chain" var="chain" pipe="and" />
		<condition operation="equal" column="result" var="result" pipe="and" />
	</conditions>
	<navigation>
		<index default="log_id" order="asc" />
		<list_count var="list_count" default="1000" />
	</navigation>
</query>
